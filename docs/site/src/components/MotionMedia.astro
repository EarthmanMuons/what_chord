---
interface Props {
  alt: string;
  fallbackSrc: string;
  videoSrc: string;
}

const { alt, fallbackSrc, videoSrc } = Astro.props;
---

<div class="feature-img-wrap motion-media" data-motion-media>
  <video
    class="motion-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
    data-motion-video
  >
    <source src={videoSrc} type="video/mp4" />
  </video>
  <img class="motion-fallback" src={fallbackSrc} alt={alt} />
  <button
    class="motion-toggle"
    type="button"
    aria-label="Pause animation"
    data-motion-toggle
    hidden
  >
    <svg
      class="motion-toggle-pause"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M8 5h3v14H8z"></path>
      <path d="M13 5h3v14h-3z"></path>
    </svg>
    <svg
      class="motion-toggle-play"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M8 5v14l11-7z"></path>
    </svg>
  </button>
</div>
