---
import type { CollectionEntry } from "astro:content";

interface Props {
  article: CollectionEntry<"articles">;
  featured?: boolean;
  showTag?: boolean;
}

const { article, featured = false, showTag = false } = Astro.props;
---

<a class="article-card" href={`/articles/${article.id}.html`}>
  {showTag && <div class="article-tag">{article.data.tag}</div>}
  <h3>{article.data.title}</h3>
  <p>
    {
      featured && article.data.featuredDescription
        ? article.data.featuredDescription
        : article.data.cardDescription
    }
  </p>
  <span class="read-more">
    {
      article.data.tag === "Reference"
        ? "Read the guide →"
        : "Read the article →"
    }
  </span>
</a>
