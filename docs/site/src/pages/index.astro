---
import { getCollection } from "astro:content";

import ArticleCard from "../components/ArticleCard.astro";
import MotionMedia from "../components/MotionMedia.astro";
import StoreBadges from "../components/StoreBadges.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredArticles = (await getCollection("articles"))
  .filter((article) => article.data.featuredOrder !== undefined)
  .sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!);
---

<BaseLayout
  description={"Identify chords from live MIDI or manual note entry, follow the key as you play, then explore chords, scales, voicings, and harmonic context. Free, no ads, all on-device."}
  socialDescription={"Play it. Explore it. Learn it. Identify chords, follow the key, and understand harmonic context with WhatChord."}
  socialTitle={"WhatChord - Chord Identification, Key Detection, and Harmony Exploration"}
  title={"WhatChord - Chord Identification, Key Detection, and Harmony Exploration"}
>
  <main>
    <!-- ─── Hero ─────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="wrap">
        <div class="hero-eyebrow">Free · No ads · All analysis on-device</div>
        <h1>Stop guessing what chord you’re playing.</h1>
        <div class="hero-screenshot">
          <img
            src="images/theme_modes.webp"
            alt="WhatChord identifying a C13♯11 chord, shown in light and dark themes side by side"
          />
        </div>
        <p class="hero-sub">
          Identify chords instantly as you play a Bluetooth or USB MIDI
          keyboard, or enter notes manually. WhatChord names the voicing,
          follows the key from recent live chords, explains close alternatives,
          and connects it to chord structures, scales, and key context.
          Available on iOS and Android.
        </p>
        <StoreBadges />
      </div>
    </section>

    <!-- ─── Features ──────────────────────────────────────────────── -->
    <section class="features">
      <div class="wrap">
        <div class="features-inner">
          <!-- Feature 1: Real-time -->
          <div class="feature">
            <div class="feature-text">
              <div class="feature-label">Real-time recognition</div>
              <h3>See the chord name as you play it.</h3>
              <p>
                WhatChord responds as notes arrive, no setup needed. It handles
                everything from simple triads to rich extended harmony with the
                same quick feedback. Chord symbols appear in whichever notation
                style you prefer, traditional symbols or text (Δ versus maj7,
                for instance).
              </p>
            </div>
            <MotionMedia
              alt="WhatChord identifying G7/B in real time, showing the chord name and piano keyboard"
              fallbackSrc="/images/real_time.webp"
              videoSrc="/images/real_time.mp4"
            />
          </div>

          <!-- Feature 2: Automatic key detection -->
          <div class="feature reverse">
            <div class="feature-text">
              <div class="feature-label">Automatic key detection</div>
              <h3>Follow the key as the music moves.</h3>
              <p>
                Auto mode listens to recent live chords and estimates the
                current key with calibrated confidence. The likelihood wheel
                shows all 24 major and minor keys, recent chords show the
                evidence trail, and ambiguous progressions can remain uncertain
                instead of forcing a guess.
              </p>
            </div>
            <div class="feature-img-wrap">
              <img
                src="images/whatkey.webp"
                alt="WhatChord showing automatic key detection in G major with 82 percent confidence, a circle-of-fifths likelihood wheel, recent chords, and the keyboard"
              />
            </div>
          </div>

          <!-- Feature 3: Explore -->
          <div class="feature">
            <div class="feature-text">
              <div class="feature-label">Explore chords and scales</div>
              <h3>Learn the harmony behind what you play.</h3>
              <p>
                Build and hear chords, browse scales, see keyboard patterns, and
                inspect diatonic harmony. Move between chord and scale views to
                understand how they fit together and turn abstract theory into
                something you can see and hear.
              </p>
            </div>
            <MotionMedia
              alt="WhatChord switching between Explore Chords and Explore Scales modes on the piano keyboard"
              fallbackSrc="/images/explore_modes.webp"
              videoSrc="/images/explore_modes.mp4"
            />
          </div>

          <!-- Feature 4: Musically informed -->
          <div class="feature reverse">
            <div class="feature-text">
              <div class="feature-label">Context-aware naming</div>
              <h3>Chord names the way musicians write them.</h3>
              <p>
                WhatChord assigns an explanation cost to multiple plausible
                interpretations, then ranks them using musical heuristics:
                inversions, extensions, upper structures, altered dominants, and
                the selected key signature. It favors the name a musician would
                usually expect. When a voicing is genuinely ambiguous, the app
                shows the alternatives rather than hiding them. Tap any of them
                to see why the current chord ranked first. When you’re comping
                with a bassist, Ensemble mode names rootless voicings as the
                chords they imply and marks the implied root on the keyboard.
              </p>
            </div>
            <div class="feature-img-wrap">
              <img
                src="images/why_this_chord.webp"
                alt="WhatChord explaining why Bm7 flat five ranked above close alternatives"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── What makes it different ────────────────────────────── -->
    <section class="difference">
      <div class="wrap">
        <div class="section-label">What makes it different</div>
        <h2 class="section-title">
          Musically informed, not just note-matched.
        </h2>
        <p class="section-sub">
          The same notes can point to more than one chord name. Context is what
          makes the useful answer possible.
        </p>
        <div class="compare-grid">
          <div class="compare-card">
            <div class="compare-label">Without musical context</div>
            <div class="compare-chord">Ambiguous</div>
            <div class="compare-notes">
              G &nbsp; B &nbsp; D &nbsp; F &nbsp; A♭
            </div>
            <p class="compare-explanation">
              These are just pitch classes. A basic note matcher does not know
              whether the A♭/G♯ key is the flat 9th of a dominant chord, or part
              of a different diminished shape.
            </p>
          </div>
          <div class="compare-card better">
            <div class="compare-label">WhatChord</div>
            <div class="compare-chord">G7♭9</div>
            <div class="compare-notes">
              G &nbsp; B &nbsp; D &nbsp; F &nbsp; A♭
            </div>
            <p class="compare-explanation">
              Recognizes the diminished color as part of a G dominant chord. It
              writes that tone as <strong>A♭, not G♯,</strong> because it is acting
              as the flat 9th above G.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Try it teaser ──────────────────────────────────────── -->
    <section class="try-teaser">
      <div class="wrap">
        <div class="try-teaser-card">
          <div class="section-label">Try it now</div>
          <h2>Identify a chord in your browser.</h2>
          <p class="section-sub">
            Nothing to install. Type a few notes and the same engine that powers
            the app will name the voicing and its close alternatives.
          </p>
          <a class="btn btn-primary" href="./try">Open the chord identifier →</a
          >
        </div>
      </div>
    </section>

    <!-- ─── Audience ───────────────────────────────────────────── -->
    <section class="audience">
      <div class="wrap">
        <div class="section-label">Who uses it</div>
        <h2 class="section-title">For players at every level.</h2>
        <div class="audience-grid">
          <div class="audience-card">
            <div class="audience-icon">🎹</div>
            <h4>Pianists &amp; keyboardists</h4>
            <p>
              Get immediate confirmation on what your hands are doing.
              Especially useful when you hear something interesting and need to
              name it fast.
            </p>
          </div>
          <div class="audience-card">
            <div class="audience-icon">🎓</div>
            <h4>Music students</h4>
            <p>
              Learn chord construction, scales, and scale degrees by exploring
              voicings interactively, or enter notes manually to identify and
              understand examples from any instrument or theory textbook.
            </p>
          </div>
          <div class="audience-card">
            <div class="audience-icon">📖</div>
            <h4>Educators</h4>
            <p>
              Demonstrate inversions, extensions, scale harmony, and altered
              chords in real time. Show students a live analysis of the exact
              notes being played in class or at rehearsal.
            </p>
          </div>
          <div class="audience-card">
            <div class="audience-icon">🎵</div>
            <h4>Composers &amp; improvisers</h4>
            <p>
              Check complex extended voicings quickly without breaking flow,
              enter harmony from a score or recording, and explore variations
              before committing them to a piece.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Privacy ────────────────────────────────────────────── -->
    <section class="privacy">
      <div class="wrap">
        <div class="privacy-inner">
          <div class="section-label">Privacy</div>
          <h2 class="section-title">On-device. Open source. No strings.</h2>
          <p class="section-sub">
            WhatChord does not collect your data, connect to the internet during
            use, or show advertisements. All analysis runs entirely on your
            device. Your playing stays yours.
          </p>
          <a
            class="oss-callout"
            href="https://github.com/EarthmanMuons/whatchord/blob/main/LICENSE"
            >Open source · Zero Clause BSD License
            <span class="oss-arrow">→</span></a
          >
        </div>
      </div>
    </section>

    <!-- ─── Articles ───────────────────────────────────────────── -->
    <section class="articles-section">
      <div class="wrap">
        <div class="section-label">Go deeper</div>
        <h2 class="section-title">How it works.</h2>
        <p class="section-sub">
          Practical articles and research notes for musicians, engineers, and
          anyone curious about the evidence behind WhatChord's analysis.
        </p>
        <div class="articles-grid">
          {
            featuredArticles.map((article) => (
              <ArticleCard article={article} featured showTag />
            ))
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
