---
import StoreBadges from "../components/StoreBadges.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  appleItunesApp={"app-id=6758409779"}
  bodyClass={"try-page"}
  canonicalPath={"/try"}
  description={"Identify a chord right in your browser. Type notes or MIDI numbers and WhatChord names the voicing using the same engine that powers the app."}
  image={"/images/try_social.jpg"}
  imageAlt={"WhatChord: Identify a chord in your browser"}
  socialDescription={"Type notes, get the chord name and its alternatives. The same on-device engine that powers the WhatChord app, running in your browser."}
  socialTitle={"Try WhatChord - Identify a Chord"}
  styles={["/css/try.css"]}
  title={"Try It - Identify a Chord | WhatChord"}
>
  <main>
    <section class="try-hero">
      <div class="wrap">
        <div class="hero-eyebrow">Musically informed analysis</div>
        <h1>Identify a chord.</h1>
        <p>
          Type note names or MIDI numbers and see the top 5 most likely chord
          candidates.
        </p>
      </div>
    </section>

    <section class="try-section">
      <div class="wrap">
        <div class="try-card">
          <label class="try-input-label" for="notes-input">Notes</label>
          <div class="try-input-wrap">
            <input
              id="notes-input"
              type="text"
              autocorrect="off"
              autocapitalize="off"
              maxlength="512"
              spellcheck="false"
              placeholder="C E G Bb D"
              aria-describedby="notes-hint"
            />
            <button
              class="try-clear"
              id="clear-notes"
              type="button"
              aria-label="Clear notes"
              hidden
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M18.3 5.7a1 1 0 0 0-1.4 0L12 10.6 7.1 5.7A1 1 0 0 0 5.7 7.1L10.6 12l-4.9 4.9a1 1 0 1 0 1.4 1.4L12 13.4l4.9 4.9a1 1 0 0 0 1.4-1.4L13.4 12l4.9-4.9a1 1 0 0 0 0-1.4z"
                ></path>
              </svg>
            </button>
          </div>
          <div class="try-hint" id="notes-hint">
            Separate with spaces, commas, or hyphens. Names like C, F#, Bb, or
            MIDI numbers like 60.<br />The first note is treated as the bass.
            Notes are <em>identified by pitch</em>, not spelling.
          </div>

          <div class="try-controls">
            <div class="try-control">
              <span>Key</span>
              <div class="try-key">
                <select class="try-select" id="key-root" aria-label="Key root"
                ></select>
                <div
                  class="try-segmented"
                  id="key-mode"
                  role="group"
                  aria-label="Key mode"
                >
                  <button type="button" data-mode="maj" aria-pressed="true">
                    Major
                  </button>
                  <button type="button" data-mode="min" aria-pressed="false">
                    Minor
                  </button>
                </div>
              </div>
            </div>

            <div class="try-control">
              <span>Notation</span>
              <div
                class="try-segmented"
                id="notation"
                role="group"
                aria-label="Chord notation style"
              >
                <button
                  type="button"
                  data-notation="textual"
                  aria-pressed="true"
                >
                  Text
                </button>
                <button
                  type="button"
                  data-notation="symbolic"
                  aria-pressed="false"
                >
                  Symbols
                </button>
              </div>
            </div>

            <div class="try-control">
              <span>Mode</span>
              <div
                class="try-segmented"
                id="playing-mode"
                role="group"
                aria-label="Playing mode"
              >
                <button
                  type="button"
                  data-playing="solo"
                  aria-pressed="true"
                  title="Chords are named from exactly the notes entered"
                >
                  Solo
                </button>
                <button
                  type="button"
                  data-playing="ensemble"
                  aria-pressed="false"
                  title="Rootless voicings are named as if a bassist covers the root"
                >
                  Ensemble
                </button>
              </div>
            </div>
          </div>

          <div class="try-results">
            <div
              class="try-status"
              id="status"
              role="status"
              aria-live="polite"
            >
              Loading engine&hellip;
            </div>
            <div class="try-results-head" id="results-head" hidden>
              <div class="try-echo" id="echo"></div>
              <div class="try-results-actions">
                <a class="btn btn-ghost" id="open-app" hidden>
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path
                      d="M14 3v2h3.6l-9.8 9.8 1.4 1.4L19 6.4V10h2V3h-7zM5 5h6V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6h-2v6H5V5z"
                    ></path>
                  </svg>
                  <span>Open in app</span>
                </a>
                <button class="btn btn-primary" id="copy-link" type="button">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path
                      d="M3.9 12a3.1 3.1 0 0 1 3.1-3.1h4V7H7a5 5 0 0 0 0 10h4v-1.9H7A3.1 3.1 0 0 1 3.9 12zm4.1 1h8v-2H8v2zm9-6h-4v1.9h4a3.1 3.1 0 0 1 0 6.2h-4V17h4a5 5 0 0 0 0-10z"
                    ></path>
                  </svg>
                  <span class="copy-label">Copy link</span>
                </button>
              </div>
            </div>
            <div id="candidates"></div>
            <p class="try-feedback" id="ranking-feedback" hidden>
              Disagree with the ranking?{" "}
              <a
                href="https://github.com/EarthmanMuons/whatchord/blob/main/SUPPORT.md"
                >Let us know</a
              >
            </p>
            <p class="try-feedback" id="symbol-legend" hidden>
              New to these symbols?{" "}
              <a href="articles/chord-symbols.html">Chord symbol guide</a>
            </p>
          </div>
        </div>

        <div class="article-cta">
          <h3>Try it on your own piano.</h3>
          <p>
            Use the same engine, live from a Bluetooth or USB MIDI keyboard,
            with deeper chord details plus modes for exploring chord structure
            and scales. Free for iOS and Android. No subscription, no ads, no
            internet required.
          </p>
          <StoreBadges spaced />
        </div>
      </div>
    </section>
  </main>
  <script is:inline src="/js/chord-id.js" slot="scripts"></script>
  <script is:inline src="/js/try.js" slot="scripts"></script>
</BaseLayout>
