    "@astrojs/sitemap": "3.7.3",
    "@tonaljs/tonal": "4.10.0",
    "astro": "7.1.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "stylelint": "17.14.1",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "wrangler": "4.114.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true,
    "fsevents@2.3.3": true
